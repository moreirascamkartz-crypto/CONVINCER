function ScanPrioritiesNow()
    if not scannerEnabled then return end
    if espScanBusy then espDirty = true return end
    espScanBusy = true; espDirty = false
    task.spawn(function()
        local ok, err = pcall(function()
            local flagged = {}
            local plots = workspace:FindFirstChild("Plots")
            local live = {}
            if plots then
                for _, plot in ipairs(plots:GetChildren()) do
                    live[plot] = true
                    local owner = getPlotOwner(plot)
                    if owner then
                        local hits, isOG = findPriorityOnPlot(plot)
                        if #hits > 0 or isOG then
                            flagged[owner:lower()] = {brainrot=hits[1] or "OG", hits=hits, isOG=isOG, plot=plot}
                            markBase(plot, owner, hits, isOG)
                        else clearBaseMark(plot) end
                    else clearBaseMark(plot) end
                end
            end
            for plot in pairs(BaseMarks) do if not live[plot] or not plot.Parent then clearBaseMark(plot) end end
            local so, si = {}, {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    local info = flagged[plr.Name:lower()] or flagged[plr.DisplayName:lower()]
                    if info and #info.hits > 0 then
                        so[plr.UserId] = plr; si[plr.UserId] = {}
                        for _, h in ipairs(info.hits) do si[plr.UserId][#si[plr.UserId]+1] = {Object=nil, Name=h} end
                    end
                    local char = plr.Character
                    local tool = char and char:FindFirstChildOfClass("Tool")
                    if tool and PriorityHit(tool.Name) then
                        so[plr.UserId] = plr; si[plr.UserId] = si[plr.UserId] or {}
                        local exists = false
                        for _, it in ipairs(si[plr.UserId]) do if tostring(it.Name):lower() == tostring(tool.Name):lower() then exists = true break end end
                        if not exists then si[plr.UserId][#si[plr.UserId]+1] = {Object=nil, Name=tool.Name} end
                    end
                end
            end
            dragonOwners = so; dragonItems = si
            if ESPPlayerEnabled then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then
                        local info = flagged[plr.Name:lower()] or flagged[plr.DisplayName:lower()]
                        if not info then
                            local char = plr.Character
                            local tool = char and char:FindFirstChildOfClass("Tool")
                            if tool and PriorityHit(tool.Name) then info = {brainrot=tool.Name, isOG=false} end
                        end
                        if info then setPriorityTag(plr, info.brainrot, info.isOG) else clearPriorityTag(plr) end
                    end
                end
            else clearAllPriorityTags() end
            for plr in pairs(PriorityTags) do if not plr.Parent then clearPriorityTag(plr) end end
            if UpdateDragonList then QueueDragonListUpdate() end
        end)
        espScanBusy = false
        if not ok then espDirty = true warn("[CONVINCER] " .. tostring(err)) end
    end)
end
