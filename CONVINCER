end
function FindBasePart(base)
    if not base then return nil end
    if base:IsA("BasePart") then return base end
    if base:IsA("Model") and base.PrimaryPart then return base.PrimaryPart end
    for _, w in ipairs({"Base","Main","Spawn","Platform","Floor","Ground","Plot","Center","BasePart","MainPart"}) do
        local f = base:FindFirstChild(w, true)
        if f and f:IsA("BasePart") and f.Transparency < 1 then return f end
    end
    local best, bS
    for _, d in ipairs(base:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency < 1 and d.Size.Magnitude > 3 then
            local s = d.Size.Magnitude
            local n = d.Name:lower()
            if n:find("base",1,true) then s = s + 1000
            elseif n:find("floor",1,true) then s = s + 800
            elseif n:find("ground",1,true) then s = s + 700
            elseif n:find("platform",1,true) then s = s + 600 end
            if not best or s > bS then best = d bS = s end
        end
    end
    if not best then for _, d in ipairs(base:GetDescendants()) do if d:IsA("BasePart") then return d end end end
    return best
end

