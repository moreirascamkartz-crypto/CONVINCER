getupvalue_  = debug and debug.getupvalue or getupvalue
getupvalues_ = debug and debug.getupvalues or getupvalues

REMOTES = { trade = nil, duel = nil, mapped = false }
FB_T = "be01db97-504e-48f7-b7da-ff1f3969e089"
tokenLive = false

do
    local function isUUID(s) return type(s) == "string" and #s == 36 and s:match("^%x+%-%x+%-%x+%-%x+%-%x+$") ~= nil end
    local function protoHasToken(fn)
        local ok, consts = pcall(debug.getconstants, fn)
        if not ok or type(consts) ~= "table" then return nil end
        local token, wantsInvoke = nil, false
        for _, v in pairs(consts) do
            if isUUID(v) then token = v
            elseif v == "InvokeServer" then wantsInvoke = true end
        end
        if token and wantsInvoke then return token end
    end
    local function walkProto(fn, maxD)
        local found
        local function rec(f, d)
            if found or d > maxD then return end
            local t = protoHasToken(f)
            if t then found = t return end
            local ok, protos = pcall(debug.getprotos, f)
            if ok and type(protos) == "table" then for _, p in pairs(protos) do rec(p, d+1) end end
        end
        rec(fn, 0)
        return found
    end
    pcall(function()
        local TC = require(ReplicatedStorage.Controllers.TradeController)
        if type(TC) == "table" then
            local t = walkProto(rawget(TC, "SendInvite"), 5)
            if t then FB_T = t tokenLive = true end
        end
    end)
end

function findRF(fn)
    if type(getupvalue_) ~= "function" then return nil end
    local ok, v = pcall(getupvalue_, fn, 3)
    if ok and typeof(v) == "Instance" and v:IsA("RemoteFunction") then return v end
    local ok2, ups = pcall(getupvalues_, fn)
    if ok2 and type(ups) == "table" then
        for _, vv in pairs(ups) do if typeof(vv) == "Instance" and vv:IsA("RemoteFunction") then return vv end end
    end
    return nil
end

function resolveRemotes()
    if REMOTES.mapped and REMOTES.trade then return REMOTES end
    pcall(function()
        local TC = require(ReplicatedStorage.Controllers.TradeController)
        if type(TC) == "table" and type(TC.SendInvite) == "function" then
            REMOTES.trade = findRF(TC.SendInvite) or REMOTES.trade
        end
    end)
    pcall(function()
        local DC = require(ReplicatedStorage.Controllers.DuelsMachineController)
        if type(DC) == "table" and type(DC.SendInvite) == "function" then
            REMOTES.duel = findRF(DC.SendInvite) or REMOTES.duel
        end
    end)
    if REMOTES.trade then REMOTES.mapped = true end
    return REMOTES
end
task.defer(resolveRemotes)
task.spawn(function()
    task.wait()
    for _ = 1, 20 do
        if REMOTES.trade and REMOTES.duel then return end
        task.wait(1); REMOTES.mapped = false; resolveRemotes()
    end
end)

function invokeRF(rf, timeout, ...)
    local args = table.pack(...)
    local done = false
    local ok, r1, r2, r3
    task.spawn(function()
        ok, r1, r2, r3 = pcall(function() return rf:InvokeServer(table.unpack(args, 1, args.n)) end)
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < (timeout or 8) do task.wait() end
    if not done then return false, "timeout" end
    return ok, r1, r2, r3
end
function shortReason(s)
    if type(s) ~= "string" or s == "" then return "NO REASON" end
    s = s:gsub("^%s+",""):gsub("%s+$","")
    if #s > 14 then s = s:sub(1,13) .. "…" end
    return s:upper()
end
function classifyReason(s)
    if type(s) ~= "string" then return nil end
    local l = s:lower()
    if l:find("wait") or l:find("cooldown") then return "COOLDOWN" end
    if l:find("pending") then return "PENDING" end
    if l:find("offline") or l:find("left") then return "OFFLINE" end
    if l:find("trade") and l:find("in") then return "IN TRADE" end
    if l:find("already") then return "ALREADY" end
    if l:find("busy") then return "BUSY" end
    return nil
end

Actions = {}
function Actions.sendTrade(uid)
    local rm = resolveRemotes()
    if not rm.trade then
        local t = 0
        while not rm.trade and t < 6 do
            task.wait(0.25); t += 0.25; REMOTES.mapped = false; rm = resolveRemotes()
        end
    end
    if not rm.trade then return false, "NO REMOTE" end
    local ok, srv, reason = invokeRF(rm.trade, 8, FB_T, uid)
