function _ensureFolder()
    local mf, isf = _env("makefolder"), _env("isfolder")
    if type(mf) ~= "function" then return end
    if type(isf) == "function" then local ok, e = pcall(isf, "Convincer"); if ok and e then return end end
    pcall(mf, "Convincer")
end
function _tryWrite(path, enc)
    local wf, rf = _env("writefile"), _env("readfile")
    if type(wf) ~= "function" then return false end
    if not pcall(wf, path, enc) then return false end
    if type(rf) == "function" then
        local ok, back = pcall(rf, path)
        if not ok or back ~= enc then return false end
    end
    return true
end
function SavePriority()
    local wf = _env("writefile")
    if type(wf) ~= "function" then return false end
    local ok, enc = pcall(function() return HttpService:JSONEncode({list = PRIORITY}) end)
    if not ok then return false end
    _ensureFolder()
    local order = {}
    if PRIORITY_SAVE_PATH then order[#order+1] = PRIORITY_SAVE_PATH end
    for _, p in ipairs(PRIORITY_SAVE_PATHS) do if p ~= PRIORITY_SAVE_PATH then order[#order+1] = p end end
    for _, p in ipairs(order) do
        if p:find("/") then _ensureFolder() end
        if _tryWrite(p, enc) then PRIORITY_SAVE_PATH = p return true end
    end
    return false
end
function LoadPriority()
    local rf, isf = _env("readfile"), _env("isfile")
    if type(rf) ~= "function" then return false end
    for _, p in ipairs(PRIORITY_SAVE_PATHS) do
        local exists = true
        if type(isf) == "function" then local okc, e = pcall(isf, p); exists = okc and e end
        if exists then
            local ok, raw = pcall(rf, p)
            if ok and type(raw) == "string" and raw ~= "" then
                local ok2, dec = pcall(function() return HttpService:JSONDecode(raw) end)
                if ok2 and type(dec) == "table" then
                    local list = dec.list or dec
                    for _, v in ipairs(list) do if type(v) == "string" and v ~= "" then PRIORITY[#PRIORITY+1] = v:lower() end end
                    PRIORITY_SAVE_PATH = p
                    return true
                end
            end
        end
    end
    return false
end
pcall(LoadPriority)
function PriorityHit(name)
