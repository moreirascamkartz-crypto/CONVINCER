function PlayerMatchesText(player, text)
    if not player or not text then return false end
    local v = tostring(text):lower()
    return v:find(player.Name:lower(),1,true) ~= nil or v:find(player.DisplayName:lower(),1,true) ~= nil
end
function GetPlotOwnerPlayer(plot)
    if not plot then return nil end
    for _, a in ipairs({"Owner","OwnerName","Player","PlayerName","Username","AssignedPlayer","AssignedPlayerName"}) do
        local v = plot:GetAttribute(a)
        if v ~= nil then
            for _, p in ipairs(Players:GetPlayers()) do
                if typeof(v) == "Instance" and v == p then return p end
                if PlayerMatchesText(p, v) then return p end
            end
        end
    end
    for _, a in ipairs({"UserId","OwnerUserId","PlayerUserId","OwnerId"}) do
        local v = tonumber(plot:GetAttribute(a))
        if v then for _, p in ipairs(Players:GetPlayers()) do if p.UserId == v then return p end end end
    end
    for _, d in ipairs(plot:GetDescendants()) do
        if d:IsA("ObjectValue") then for _, p in ipairs(Players:GetPlayers()) do if d.Value == p then return p end end end
        if d:IsA("StringValue") and d.Value ~= "" then for _, p in ipairs(Players:GetPlayers()) do if PlayerMatchesText(p, d.Value) then return p end end end
        if (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) and d.Text ~= "" then
            for _, p in ipairs(Players:GetPlayers()) do if PlayerMatchesText(p, d.Text) then return p end end
        end
    end
    local pn = plot.Name:lower()
    for _, p in ipairs(Players:GetPlayers()) do if pn == p.Name:lower() or pn == p.DisplayName:lower() then return p end end
    return nil
end
function IsPossibleBase(obj)
    if not obj then return false end
    local n = obj.Name:lower()
    return n:find("plot",1,true) ~= nil or n:find("base",1,true) ~= nil or n:find("tycoon",1,true) ~= nil
end
function FindPlayerBase(player)
    if not player then return nil end
    local cached = playerBases[player.UserId]
    if cached and cached:IsDescendantOf(workspace) then
        local owner = GetPlotOwnerPlayer(cached)
        if owner == player then return cached else playerBases[player.UserId] = nil end
    end
    for _, cname in ipairs({"Plots","Bases","BasePlots","PlotBases","Tycoons","PlazaPlots","Spawns"}) do
        local container = workspace:FindFirstChild(cname)
        if container then
            for _, obj in ipairs(container:GetChildren()) do
                if (obj:IsA("Model") or obj:IsA("Folder")) and IsPossibleBase(obj) then
                    local owner = GetPlotOwnerPlayer(obj)
                    if owner == player then
                        playerBases[player.UserId] = obj
                        return obj
                    end
                end
            end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Folder") then
            if obj:FindFirstChild("PlotSign") then
                local owner = GetPlotOwnerPlayer(obj)
                if owner == player then
                    playerBases[player.UserId] = obj
                    return obj
                end
            end
        end
    end
    local nl = player.Name:lower()
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("Folder") then
            for _, sub in ipairs(obj:GetChildren()) do
                if (sub:IsA("Model") or sub:IsA("Folder")) and IsPossibleBase(sub) then
                    if sub.Name:lower():find(nl, 1, true) or (sub:FindFirstChild("PlotSign") and GetPlotOwnerPlayer(sub) == player) then
                        playerBases[player.UserId] = sub
                        return sub
                    end
                end
            end
        end
