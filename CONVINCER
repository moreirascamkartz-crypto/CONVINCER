function addCatalogName(n)
    if type(n) ~= "string" then return false end
    n = n:gsub("^%s+", ""):gsub("%s+$", "")
    if n == "" or #n > 60 then return false end
    local low = n:lower()
    if Catalog[low] then return false end
    Catalog[low] = n
    CatalogList[#CatalogList + 1] = n
    return true
end
function safeReq(inst)
    if not inst or not inst:IsA("ModuleScript") then return nil end
    if setthreadidentity then pcall(setthreadidentity, 8) end
    local ok, res = pcall(require, inst)
    return ok and res or nil
end
function harvestModule(AD)
    if type(AD) ~= "table" then return 0 end
    local added = 0
    for index, info in pairs(AD) do
        local disp = nil
        if type(info) == "table" then
            if info.Egg ~= true and info.LuckyBlock ~= true then
                disp = (type(info.DisplayName) == "string" and info.DisplayName ~= "") and info.DisplayName or (type(index) == "string" and index or nil)
            end
        elseif type(index) == "string" then disp = index end
        if disp and addCatalogName(disp) then added = added + 1 end
        if type(index) == "string" and disp then Catalog[index:lower()] = disp end
    end
    return added
end
function buildCatalog()
    local added = 0
    local datas = ReplicatedStorage:FindFirstChild("Datas")
    local mod = datas and datas:FindFirstChild("Animals")
    if mod then added = added + harvestModule(safeReq(mod)) end
    if added == 0 then
        local deep = ReplicatedStorage:FindFirstChild("Animals", true)
        if deep and deep:IsA("ModuleScript") then added = added + harvestModule(safeReq(deep)) end
    end
    if added == 0 then
        for _, folderName in ipairs({"Animals","Brainrots","Pets","Characters"}) do
            local f = ReplicatedStorage:FindFirstChild(folderName, true)
            if f and not f:IsA("ModuleScript") then
                for _, ch in ipairs(f:GetChildren()) do
                    if ch:IsA("Model") or ch:IsA("Folder") then if addCatalogName(ch.Name) then added = added + 1 end end
                end
                if added > 0 then break end
            end
        end
    end
    if added > 0 then table.sort(CatalogList) end
    return added > 0
end
task.spawn(function()
    local tries = 0
    while tries < 40 do
        if #CatalogList > 0 then break end
        pcall(buildCatalog); tries = tries + 1; task.wait(0.5)
    end
    while true do
        if #CatalogList == 0 then pcall(buildCatalog) end
        task.wait(10)
    end
end)
