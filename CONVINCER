-- TRADE LOOP MAIN
-- ============================================================ --
tradeUIRoot = nil
function UpdateTradeOverlay()
    local nm = findTradePartnerLabel()
    if nm then
        local vp = playerNamed(nm)
        if not vp or vp == LocalPlayer or vp.UserId == LocalPlayer.UserId then nm = nil end
    end
    if nm then
        tradeClosedAt = nil
        if nm ~= currentPartner then
            currentPartner = nm
            tradeName.Text = "@" .. nm
            local plr = playerNamed(nm)
            currentPartnerId = (plr and plr ~= LocalPlayer) and plr.UserId or nil
            if currentPartnerId then
                tradePfp.Image = "rbxthumb://type=AvatarHeadShot&id=" .. currentPartnerId .. "&w=150&h=150"
            else
                tradePfp.Image = ""
                task.spawn(function()
                    local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(nm) end)
                    if ok and type(id) == "number" and currentPartner == nm then
                        currentPartnerId = id
                        tradePfp.Image = "rbxthumb://type=AvatarHeadShot&id=" .. id .. "&w=150&h=150"
                    end
                end)
            end
            tradeUIRoot = nil
        end
        if AutoSendEnabled and currentPartnerId and not AutoSendRunning and AutoSendHandledPartner ~= currentPartnerId then
            AutoSendHandledPartner = currentPartnerId
            RunAutoSendSequence(currentPartnerId)
        end
        if not tradeUIRoot or not tradeUIRoot.Parent then
            local root = LocalPlayer:FindFirstChild("PlayerGui")
            if root then
                local best, bestArea = nil, 0
                for _, o in ipairs(root:GetDescendants()) do
                    if o:IsA("TextLabel") and o.Visible then
                        local t = tostring(o.Text)
                        local t2 = t:match("@([%w_]+)'s")
                        if t2 and t:lower():find("offer", 1, true) then
                            local cur = o
                            while cur and cur.Parent do
                                if cur:IsA("GuiObject") and cur.Visible then
                                    local a = cur.AbsoluteSize.X * cur.AbsoluteSize.Y
                                    if a > bestArea then best, bestArea = cur, a end
                                end
                                if cur:IsA("ScreenGui") then break end
                                cur = cur.Parent
                            end
                            break
                        end
                    end
                end
                if best then tradeUIRoot = best end
            end
        end
        if tradeUIRoot and tradeUIRoot.Parent then
            local p, sz = tradeUIRoot.AbsolutePosition, tradeUIRoot.AbsoluteSize
            tradeCard.Position = UDim2.fromOffset(math.floor(p.X + sz.X * 0.5 - 160), math.floor(p.Y + 8))
        end
        if not tradeCard.Visible then tradeCard.Visible = true end
    else
        if tradeCard.Visible then tradeCard.Visible = false end
        if not tradeClosedAt then tradeClosedAt = tick() end
        if tradeClosedAt and tick() - tradeClosedAt > 2 then
            currentPartner = nil
            currentPartnerId = nil
            AutoSendHandledPartner = nil
            AutoSendRunning = false
            tradeUIRoot = nil
            tradeClosedAt = nil
        end
    end
end

