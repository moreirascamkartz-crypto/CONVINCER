function getPlotOwner(plot)
    local sign = plot and plot:FindFirstChild("PlotSign")
    if not sign then return nil end
    local gui = sign:FindFirstChildWhichIsA("SurfaceGui", true)
    if not gui then return nil end
    local lbl = gui:FindFirstChildWhichIsA("TextLabel", true)
    if not lbl or type(lbl.Text) ~= "string" or lbl.Text == "" then return nil end
    local t = lbl.Text
    local low = t:lower()
    if low:find("empty",1,true) or low:find("your base",1,true) then return nil end
    return t:match("^(.+)'s Base$") or t
end
function detectOG(m)
    if not m then return false end
    if m.Name:upper():find(" OG ", 1, true) then return true end
    local ok, attrs = pcall(m.GetAttributes, m)
    if ok and type(attrs) == "table" then
        for k, v in pairs(attrs) do
            local kk, vv = tostring(k):upper(), tostring(v):upper()
            if kk == "OG" and (v == true or vv:find("OG",1,true)) then return true end
            if (kk == "TRAIT" or kk == "TRAITS" or kk == "MUTATION") and vv:find("OG",1,true) then return true end
        end
    end
    return false
end
function findPriorityOnPlot(plot)
    local names, seenNames, isOG = {}, {}, false
    if not plot then return names, isOG end
    local function check(m)
        if not m or not m:IsA("Model") then return end
        if SKIP_NAMES[m.Name] then return end
        if Players:GetPlayerFromCharacter(m) then return end
        if PriorityHit(m.Name) then
            local low = m.Name:lower()
            if not seenNames[low] then seenNames[low] = true names[#names+1] = m.Name end
        end
        if detectOG(m) then isOG = true end
    end
    local pods = plot:FindFirstChild("AnimalPodiums")
    if pods then for _, m in ipairs(pods:GetDescendants()) do check(m) end end
    for _, m in ipairs(plot:GetChildren()) do if m ~= pods then check(m) end end
    return names, isOG
end

