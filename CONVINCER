function addPriority(txt)
    txt = tostring(txt or ""):gsub("^%s+",""):gsub("%s+$","")
    if txt == "" then return end
    local low = txt:lower()
    for _, v in ipairs(PRIORITY) do if v == low then return end end
    PRIORITY[#PRIORITY+1] = low
    rebuildChips(); SavePriority(); ForceRescanPriorities()
end
