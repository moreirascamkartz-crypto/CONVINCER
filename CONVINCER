    local p = obj.Parent
    while p and p ~= workspace do
        local pn = p.Name:lower()
        if p:FindFirstChild("PlotSign") or p:FindFirstChild("Sign") or pn:find("plot",1,true) or pn:find("base",1,true) or pn:find("tycoon",1,true) then return p end
        p = p.Parent
    end
