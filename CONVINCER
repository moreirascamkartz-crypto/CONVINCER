function ProcessObject(obj)
    if not scannerEnabled or not obj or not obj.Parent or not obj:IsA("Model") then return end
    if detectedObjects[obj] then return end
    for _, p in ipairs(Players:GetPlayers()) do if p.Character and obj:IsDescendantOf(p.Character) then return end end
    local raw = obj.Name
    if not raw or IsBlacklisted(raw) then return end
    if not PriorityHit(raw) then return end
    local tp = FindObjectPlot(obj)
    if not tp then return end
    local owner = GetPlotOwnerPlayer(tp)
    if not owner or owner == LocalPlayer then return end
    detectedObjects[obj] = true
    playerBases[owner.UserId] = tp
    dragonOwners[owner.UserId] = owner
    dragonItems[owner.UserId] = dragonItems[owner.UserId] or {}
    local exists = false
    for _, it in ipairs(dragonItems[owner.UserId]) do if it.Object == obj or it.Name:lower() == raw:lower() then exists = true break end end
    if not exists then
        table.insert(dragonItems[owner.UserId], {Object=obj, Name=raw})
        PlayAlertSound()
    end
    if UpdateDragonList then QueueDragonListUpdate() end
end
SCAN_BATCH_SIZE = 150
scanBusy = false
function ScanAll()
    if not scannerEnabled or scanBusy then return end
    scanBusy = true
    task.spawn(function()
        local objs = workspace:GetDescendants()
        local total, idx = #objs, 1
        while idx <= total do
            if not scannerEnabled then break end
            local processed = 0
            while processed < SCAN_BATCH_SIZE and idx <= total do
                local obj = objs[idx]; idx = idx + 1; processed = processed + 1
                pcall(ProcessObject, obj)
            end
            task.wait(0.05)
        end
        scanBusy = false
        QueueDragonListUpdate()
    end)
end
