            local t = tostring(o.Text or "")
            local low = t:lower()
            local nm = t:match("@([%w_]+)'s%s*[Oo]ffer") or t:match("@([%w_]+)'s") or t:match("^([%w_]+)'s%s*[Oo]ffer") or t:match("@([%w_]+)")
            if nm and not isMe(nm) then
                local plr = Players:FindFirstChild(nm)
                if not plr then
                    for _, q in ipairs(Players:GetPlayers()) do
                        if q.Name:lower() == nm:lower() or q.DisplayName:lower() == nm:lower() then plr = q break end
                    end
                end
                if plr and plr ~= LocalPlayer and plr.UserId ~= LocalPlayer.UserId then
                    local score = 0
                    if low:find("offer",1,true) then score += 1000 end
                    if low:find("trading",1,true) then score += 300 end
                    if low:find("trade",1,true) then score += 200 end
                    if o.AbsoluteSize.X > 0 and o.AbsoluteSize.Y > 0 then score += 1 end
                    if score > bestScore then bestScore = score bestName = plr.Name bestObj = o end
                end
            end
        end
    end
    return bestName, bestObj
end
function findTradeChatBox()
    local root = PlayerGui
    if not root then return nil end
    local best, bS = nil, -1
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("TextBox") and d.Visible then
            local s = 0
            local cur, depth = d, 0
            while cur and depth < 10 do
                local n = tostring(cur.Name or ""):lower():gsub("%s+", "")
                local ph = ""
                pcall(function() ph = tostring(cur.PlaceholderText or ""):lower() end)
                if n == "normalchat" or n == "restrictedchat" then s += 1000 end
                if n:find("tradechat",1,true) then s += 900 end
                if n:find("chatinput",1,true) then s += 700 end
                if n:find("input",1,true) then s += 100 end
                if n:find("message",1,true) then s += 100 end
                if ph:find("digite",1,true) then s += 800 end
                if ph:find("type",1,true) then s += 100 end
                if ph:find("message",1,true) then s += 100 end
                if ph:find("chat",1,true) then s += 100 end
                cur = cur.Parent; depth += 1
            end
            if s > bS then best, bS = d, s end
        end
    end
    if bS < 100 then return nil end
    return best
end
function sendViaTCS(text)
    local ok, sent = pcall(function()
        local TCS = game:GetService("TextChatService")
        local chs = TCS and TCS:FindFirstChild("TextChannels")
        if not chs then return false end
        for _, ch in ipairs(chs:GetChildren()) do
            if ch:IsA("TextChannel") and ch.Name:lower():find("trade",1,true) then
                local g = pcall(function() ch:SendAsync(text) end)
                if g then return true end
            end
        end
        return false
    end)
    return ok and sent == true
end
function isTradeOpen()
    local nm = findTradePartnerLabel()
    return nm ~= nil and nm ~= ""
end
function sendTradeChatInstant(text)
    if type(text) ~= "string" or text == "" then return false end
    if not isTradeOpen() then return false end
    local box = findTradeChatBox()
    if box and box:IsA("TextBox") and box.Visible then
        local ok = pcall(function()
            box.ClearTextOnFocus = false
            box:CaptureFocus()
            task.wait(0.03)
            box.Text = text
            box.CursorPosition = #text + 1
            VIM:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
            VIM:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
            if box:IsFocused() then pcall(function() box:ReleaseFocus(true) end) end
        end)
        if ok then return true end
    end
    return sendViaTCS(text)
end

