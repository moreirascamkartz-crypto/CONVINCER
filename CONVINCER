function DetectPriorityTradeRequest()
    for _, o in ipairs(PlayerGui:GetDescendants()) do
        if o:IsA("TextLabel") and o.Visible then
            local t = tostring(o.Text):lower()
            if t:find("want") and (t:find("trade") or t:find("trocar")) then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and t:find(plr.Name:lower(), 1, true) then
                        if dragonOwners[plr.UserId] then
                            local now = tick()
                            if not seenTradeNotifs["req_"..plr.UserId] or now - seenTradeNotifs["req_"..plr.UserId] > 30 then
                                seenTradeNotifs["req_"..plr.UserId] = now
                                local items = dragonItems[plr.UserId] or {}
                                local br = items[1] and items[1].Name or "priority"
                                ShowPriorityNotify(plr, br)
                            end
                        end
                    end
                end
            end
        end
    end
end

